/**
 * 89TV is a static site: `next build` exports it to ./out and `wrangler deploy` uploads that folder as
 * static assets. There's no `main`, so no Worker code runs (and static asset requests aren't billed).
 * https://developers.cloudflare.com/workers/static-assets/
 */
{
	"name": "89tv",
	"compatibility_date": "2026-10-01",
	"assets": {
		"directory": "./out",
		// Next's export writes 404.html; serve it for unknown paths.
		"not_found_handling": "404-page"
	}
}
